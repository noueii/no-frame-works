#!/usr/bin/env bash
set -euo pipefail

# Agent setup script. Run from inside a git worktree.
# Discovers main repo via git, registers in .agents/registry.json,
# computes isolated ports, starts docker stack.

command -v jq >/dev/null 2>&1 || { echo "Error: jq is required"; exit 1; }
command -v docker >/dev/null 2>&1 || { echo "Error: docker is required"; exit 1; }

WORKTREE=$(git rev-parse --show-toplevel)
GIT_COMMON_DIR=$(git rev-parse --git-common-dir)

if [[ "$GIT_COMMON_DIR" == /* ]]; then
    MAIN_REPO=$(dirname "$GIT_COMMON_DIR")
else
    MAIN_REPO="$WORKTREE"
fi

if [[ "$WORKTREE" == "$MAIN_REPO" ]]; then
    echo "Error: This script is for worktrees. For the main repo, use 'make init'."
    exit 1
fi

REGISTRY="$MAIN_REPO/.agents/registry.json"
LOCK="$MAIN_REPO/.agents/registry.lock"
mkdir -p "$(dirname "$REGISTRY")"

# Acquire exclusive lock
exec 200>"$LOCK"
flock -x 200 || { echo "Error: Could not acquire registry lock"; exit 1; }

# Ensure registry exists
if [[ ! -f "$REGISTRY" ]]; then
    echo '{"agents":{}}' > "$REGISTRY"
fi

# Check if already registered
ID=$(jq -r --arg wt "$WORKTREE" '.agents | to_entries[] | select(.value.worktree == $wt) | .key' "$REGISTRY" | head -n1 || true)

if [[ -n "$ID" ]]; then
    echo "Worktree already registered as agent $ID"
else
    # Find smallest free ID >= 1
    ID=$(jq -r '[.agents | keys[] | tonumber] | sort | . as $ids | range(1; ($ids | max // 0) + 2) | select(. as $i | $ids | index($i) | not) | .' "$REGISTRY" | head -n1)

    BRANCH=$(git -C "$WORKTREE" branch --show-current)

    jq --arg id "$ID" --arg wt "$WORKTREE" --arg branch "$BRANCH" \
       '.agents[$id] = {worktree: $wt, branch: $branch, created_at: now | todateiso8601}' \
       "$REGISTRY" > "$REGISTRY.tmp" && mv "$REGISTRY.tmp" "$REGISTRY"

    echo "Registered as agent $ID"
fi

flock -u 200

# Port allocation
APP_PORT=$((8110 + ID))
POSTGRES_PORT=$((5442 + ID * 10))
REDIS_PORT=$((6390 + ID))
KRATOS_PUBLIC=$((4433 + ID * 10))
KRATOS_ADMIN=$((4434 + ID * 10))
MAIL_WEB=$((4436 + ID * 10))
MAIL_SMTP=$((4437 + ID * 10))

# Write env files
mkdir -p "$WORKTREE/backend"

cat > "$WORKTREE/backend/.env" <<EOF
APP_ENV=local
SERVER_PORT=${APP_PORT}
LOG_LEVEL=debug
APP_BASE_URL="http://localhost:3000/"
APP_LOGIN_REDIRECT_URL="http://localhost:3000/login"
APP_LOGOUT_REDIRECT_URL="http://localhost:3000/login"
APP_SECRET=abababababababababababababababababababababababababababababababab
DATABASE_MAX_CONNS=10
DATABASE_NAME="no_frame_works"
DATABASE_URL="postgresql://postgres:postgres@localhost:${POSTGRES_PORT}/no_frame_works?sslmode=disable"
REDIS_HOST="localhost"
REDIS_PORT="${REDIS_PORT}"
REDIS_PASSWORD=""
REDIS_DB="0"
KRATOS_PUBLIC_URL="http://localhost:${KRATOS_PUBLIC}"
KRATOS_ADMIN_URL="http://localhost:${KRATOS_ADMIN}"
SENTRY_ENV=local
SENTRY_DSN=
EOF

cp "$WORKTREE/backend/.env" "$WORKTREE/backend/.env.local"

cat > "$WORKTREE/backend/.env.test" <<EOF
APP_ENV=test
SERVER_PORT=${APP_PORT}
LOG_LEVEL=debug
APP_BASE_URL="http://localhost:3000/"
APP_LOGIN_REDIRECT_URL="http://localhost:3000/login/redirect"
APP_LOGOUT_REDIRECT_URL="http://localhost:8001/session/delete"
APP_SECRET=abababababababababababababababababababababababababababababababab
DATABASE_MAX_CONNS=10
DATABASE_NAME="no_frame_works_test"
DATABASE_URL="postgresql://postgres:postgres@localhost:${POSTGRES_PORT}/no_frame_works_test?sslmode=disable"
REDIS_HOST="localhost"
REDIS_PORT="${REDIS_PORT}"
REDIS_PASSWORD=""
REDIS_DB="0"
KRATOS_PUBLIC_URL="http://localhost:${KRATOS_PUBLIC}"
KRATOS_ADMIN_URL="http://localhost:${KRATOS_ADMIN}"
SENTRY_ENV=local
SENTRY_DSN=
EOF

# Generate docker compose override from template
export AGENT_NAME="nfw-agent-${ID}"
export DB_VOLUME="db_data_agent_${ID}"
export POSTGRES_PORT REDIS_PORT KRATOS_PUBLIC KRATOS_ADMIN MAIL_WEB MAIL_SMTP
envsubst < "$MAIN_REPO/backend/docker-compose.agent.yml.template" > "$WORKTREE/backend/docker-compose.agent.yml"

cd "$WORKTREE/backend"

echo "Starting docker compose for agent $ID..."
docker compose -f docker-compose.yml -f docker-compose.agent.yml up -d

echo "Waiting for postgres..."
for i in {1..30}; do
    if docker compose -f docker-compose.yml -f docker-compose.agent.yml exec -T db pg_isready -U postgres >/dev/null 2>&1; then
        echo "Postgres ready"
        break
    fi
    if [[ $i -eq 30 ]]; then
        echo "Error: Postgres failed to become ready"
        exit 1
    fi
    sleep 1
done

echo "Creating test database if needed..."
TEST_DB_EXISTS=$(docker compose -f docker-compose.yml -f docker-compose.agent.yml exec -T db psql -U postgres -tc "SELECT 1 FROM pg_database WHERE datname = 'no_frame_works_test'" 2>/dev/null | tr -d '[:space:]')
if [[ "$TEST_DB_EXISTS" != "1" ]]; then
    docker compose -f docker-compose.yml -f docker-compose.agent.yml exec -T db psql -U postgres -c "CREATE DATABASE no_frame_works_test;"
    echo "Test database created"
fi

echo "Running migrations..."
go tool goose -dir db/migrations postgres "postgresql://postgres:postgres@localhost:${POSTGRES_PORT}/no_frame_works?sslmode=disable" up

echo "Checking for main database data to copy..."
if docker run --rm --network=host postgres:18 pg_isready -h localhost -p 5442 -U postgres >/dev/null 2>&1; then
    echo "Main database found at localhost:5442, copying data..."
    docker run --rm --network=host -e PGPASSWORD=postgres postgres:18 bash -c "
        pg_dump -h localhost -p 5442 -U postgres -d no_frame_works --data-only --exclude-table=goose_db_version | \
        psql -h localhost -p ${POSTGRES_PORT} -U postgres -d no_frame_works
    " || echo "Warning: data copy failed, continuing with empty database"
else
    echo "Main database not available, starting with empty database"
fi

go tool goose -dir db/migrations postgres "postgresql://postgres:postgres@localhost:${POSTGRES_PORT}/no_frame_works_test?sslmode=disable" up

echo ""
echo "=== Agent $ID ready ==="
echo "Worktree:      $WORKTREE"
echo "App port:      $APP_PORT"
echo "Postgres:      localhost:$POSTGRES_PORT"
echo "Redis:         localhost:$REDIS_PORT"
echo "Kratos public: http://localhost:$KRATOS_PUBLIC"
echo "Kratos admin:  http://localhost:$KRATOS_ADMIN"
